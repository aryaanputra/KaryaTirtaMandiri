<jasperReport name="surat_jalan" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f490a625-b75e-4241-b56b-150b3f88a680">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="karyatirtamandiri.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="no_surat_jalan" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{no_surat_jalan}]]></defaultValueExpression>
	</parameter>
	<parameter name="no_faktur" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{no_faktur}]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT
    sj.no_surat_jalan,
    sj.no_faktur,
    sj.tanggal_surat,

    p.nama_pelanggan,
    p.tanggal,
    p.tanggal_pengiriman,
    p.keterangan,
    p.bayar,
    p.total,
    p.kembalian,

    d.nama_barang,
    d.jumlah,
    d.harga_jual,

    k.merk_kendaraan,
    k.platnomor,

    pg.nama_pengemudi

FROM tb_surat_jalan sj

INNER JOIN tb_pemesanan p
    ON sj.no_faktur = p.no_faktur

INNER JOIN tb_detail_pemesanan d
    ON p.no_faktur = d.no_faktur

INNER JOIN tb_kendaraan k
    ON sj.id_kendaraan = k.id_kendaraan

INNER JOIN tb_pengemudi pg
    ON sj.id_pengemudi = pg.id_pengemudi

WHERE sj.no_faktur = $P{no_faktur};]]></query>
