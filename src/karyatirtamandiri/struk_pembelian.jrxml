	<query language="sql"><![CDATA[SELECT 
    tb_pemesanan.no_faktur,
    tb_pemesanan.id_pelanggan,
    tb_pemesanan.nama_pelanggan,
    tb_pemesanan.tanggal,
    tb_pemesanan.bayar,
    tb_pemesanan.total,
    tb_pemesanan.kembalian,
    tb_detail_pemesanan.jumlah,
    tb_detail_pemesanan.harga_jual,
    tb_detail_pemesanan.nama_barang,
    tb_detail_pemesanan.id_barang
FROM tb_pemesanan
JOIN tb_detail_pemesanan
ON tb_pemesanan.no_faktur = tb_detail_pemesanan.no_faktur
WHERE tb_pemesanan.no_faktur = 20260511094914]]></query>
